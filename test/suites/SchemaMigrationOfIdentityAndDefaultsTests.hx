package suites;

import codequery.SqlDate;
import codequery.migrations.*;
import codequery.sqldrivers.SqlTranslator;
import codequery.testing.Assert;
import codequery.testing.TestCase;
import suites.MigrationRunnerTests.TempFolder;
import sys.io.File;

/** An ordinary generated key. */
@tableName("mig_key")
class ByDefaultKey {
	public var id:Int = 0;
	public var size:Int = 0;

	public function new() {}
}

/** The same key, kept to the database. */
@tableName("mig_key")
class AlwaysKey {
	@:primaryKey(identity = Always) public var id:Int = 0;
	public var size:Int = 0;

	public function new() {}
}

/** The same key, the old spelling. */
@tableName("mig_key")
class SerialKey {
	@:primaryKey(identity = Serial) public var id:Int = 0;
	public var size:Int = 0;

	public function new() {}
}

/** The same key, no longer generated at all. */
@tableName("mig_key")
class PlainKey {
	@:primaryKey(autoIncrement = false) public var id:Int = 0;
	public var size:Int = 0;

	public function new() {}
}

@tableName("mig_default")
class GuestsAreTwo {
	public var id:Int = 0;
	public var guests:Int = 2;

	public function new() {}
}

@tableName("mig_default")
class GuestsAreFive {
	public var id:Int = 0;
	public var guests:Int = 5;

	public function new() {}
}

@tableName("mig_default")
class GuestsAreWhateverYouSay {
	public var id:Int = 0;
	public var guests:Int = 0;

	public function new() {}
}

@tableName("mig_stamp")
class Stamped {
	public var id:Int = 0;
	@columnNullable(false) public var created:SqlDate = Date.now();
	@columnNullable(false) public var token:String = Std.string(Math.random());

	public function new() {}
}

/** A migrations folder of one test's own, and the schema versions scaffolded into it. */
class Scaffolding {
	final dir:String;
	final translator = new SqlTranslator();

	public function new(dir:String) {
		this.dir = dir;
	}

	/** Scaffolds the migration to `table`, and hands back what it will run. */
	public function Migrate(table:DatabaseTableDefinition):String {
		Assert.isTrue(AnythingChanged(table), '${table.Name} scaffolded no migration.');
		return Read("up.sql");
	}

	/** Whether scaffolding `table` again finds anything to write. */
	public function AnythingChanged(table:DatabaseTableDefinition):Bool {
		return MigrationRunner.AddMigrationIfSchemaChanged(SchemaSnapshot.FromTables([table]), dir, translator).HasChanges;
	}

	/** The way back out of the last migration. */
	public function LatestDown():String {
		return Read("down.sql");
	}

	function Read(file:String):String {
		final folders = TempFolder.Folders(dir);
		return File.getContent('$dir/${folders[folders.length - 1]}/$file');
	}
}

/**
	`SchemaMigrationOfIdentityAndDefaultsTests.cs`: which form a key's identity takes, and the default
	a field's initializer states, both survive the round trip a migration is — declared in code,
	written to a snapshot, read back, and diffed against the next version of the code.
**/
class SchemaMigrationOfIdentityAndDefaultsTests extends TestCase {
	var root:String;

	override public function setUp() {
		root = TempFolder.Make("cq-mig");
	}

	override public function tearDown() {
		TempFolder.Remove(root);
	}

	function Scaffold(name:String):Scaffolding {
		sys.FileSystem.createDirectory('$root/$name');
		return new Scaffolding('$root/$name');
	}

	// ---- identity ----

	function testTheFirstMigration_CreatesTheTableInTheFormThatWasDeclared() {
		Assert.contains("GENERATED ALWAYS AS IDENTITY", Scaffold("always").Migrate(SchemaInspector.FromType(AlwaysKey)));
	}

	function testSerialSurvivesToTheMigration_AsATypeRatherThanAKeyword() {
		final sql = Scaffold("serial").Migrate(SchemaInspector.FromType(SerialKey));
		Assert.contains("id SERIAL", sql);
		Assert.doesNotContain("IDENTITY", sql);
	}

	function testChangingTheForm_IsFoundByTheDiff_AndWrittenAsItsOwnAction() {
		final scaffolding = Scaffold("form");
		scaffolding.Migrate(SchemaInspector.FromType(ByDefaultKey));
		final sql = scaffolding.Migrate(SchemaInspector.FromType(AlwaysKey));
		Assert.contains("ALTER COLUMN id SET GENERATED ALWAYS", sql);
		Assert.contains("ALTER COLUMN id SET GENERATED BY DEFAULT", scaffolding.LatestDown());
	}

	function testGivingUpTheIdentity_DropsIt() {
		final scaffolding = Scaffold("drop");
		scaffolding.Migrate(SchemaInspector.FromType(ByDefaultKey));
		Assert.contains("ALTER COLUMN id DROP IDENTITY IF EXISTS", scaffolding.Migrate(SchemaInspector.FromType(PlainKey)));
	}

	function testTakingOneOn_AddsIt() {
		final scaffolding = Scaffold("add");
		scaffolding.Migrate(SchemaInspector.FromType(PlainKey));
		Assert.contains("ALTER COLUMN id ADD GENERATED ALWAYS AS IDENTITY", scaffolding.Migrate(SchemaInspector.FromType(AlwaysKey)));
	}

	function testTheFormIsInTheSnapshot_SoDeclaringItAgainIsNotAChange() {
		final scaffolding = Scaffold("stable-identity");
		scaffolding.Migrate(SchemaInspector.FromType(AlwaysKey));
		Assert.isFalse(scaffolding.AnythingChanged(SchemaInspector.FromType(AlwaysKey)));
	}

	// ---- defaults read from the field ----

	function testTheFirstMigration_CarriesTheDefaultThePropertyStates() {
		Assert.contains("guests INTEGER NOT NULL DEFAULT 2", Scaffold("default").Migrate(SchemaInspector.FromType(GuestsAreTwo)));
	}

	function testChangingTheInitializer_IsAChangeOfDefault() {
		final scaffolding = Scaffold("changed-default");
		scaffolding.Migrate(SchemaInspector.FromType(GuestsAreTwo));
		final sql = scaffolding.Migrate(SchemaInspector.FromType(GuestsAreFive));
		Assert.contains("ALTER COLUMN guests SET DEFAULT 5", sql);
		Assert.contains("ALTER COLUMN guests SET DEFAULT 2", scaffolding.LatestDown());
	}

	function testRemovingTheInitializer_DropsTheDefault() {
		final scaffolding = Scaffold("dropped-default");
		scaffolding.Migrate(SchemaInspector.FromType(GuestsAreTwo));
		Assert.contains("ALTER COLUMN guests DROP DEFAULT", scaffolding.Migrate(SchemaInspector.FromType(GuestsAreWhateverYouSay)));
	}

	function testTheDefaultIsInTheSnapshot_SoScaffoldingAgainFindsNothing() {
		final scaffolding = Scaffold("stable-default");
		scaffolding.Migrate(SchemaInspector.FromType(GuestsAreTwo));
		Assert.isFalse(scaffolding.AnythingChanged(SchemaInspector.FromType(GuestsAreTwo)));
	}

	/** A moving value is not read as a default: it would compare against the last scaffold's moment and call it a change, for ever. */
	function testAValueThatDiffersEachRun_NeverBecomesAMigration() {
		final scaffolding = Scaffold("moving");
		final sql = scaffolding.Migrate(SchemaInspector.FromType(Stamped));
		// Declared as they are, with nothing after the nullability — no DEFAULT of last Tuesday.
		Assert.contains("created TIMESTAMP NOT NULL,", sql);
		Assert.contains("token TEXT NOT NULL,", sql);
		Assert.isFalse(scaffolding.AnythingChanged(SchemaInspector.FromType(Stamped)));
		Assert.isFalse(scaffolding.AnythingChanged(SchemaInspector.FromType(Stamped)));
	}
}
