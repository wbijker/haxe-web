package codequery.sqlexpressions;

import codequery.IdentityKind;

/** What a column definition may say beyond its name, type and nullability. */
typedef ColumnOptions = {
	?defaultValue:ISqlExpression,
	?maxLength:Int,
	?precision:Int,
	?scale:Int,
	?generatedExpression:String,
	?generatedStored:Bool,
	?isAutoIncrement:Bool,
	?serverGeneratedGuid:Bool,
	?generatedExpressionTree:ISqlExpression,
	?collation:String,
	?identity:IdentityKind
}

/** A column as a CREATE TABLE says it — the C# `ColumnDefinition`. */
class ColumnDefinition {
	public final Name:String;
	public final Type:SqlType;
	public final IsNullable:Bool;
	public final DefaultValue:Null<ISqlExpression>;
	public final MaxLength:Null<Int>;
	public final Precision:Null<Int>;
	public final Scale:Null<Int>;

	/** The SQL expression for a generated/computed column (null for a normal column). */
	public final GeneratedExpression:Null<String>;

	/** The generated expression as a tree, for a driver to render in its own spelling. */
	public final GeneratedExpressionTree:Null<ISqlExpression>;

	/** Whether a generated column is stored rather than computed on read. */
	public final GeneratedStored:Null<Bool>;

	/** Whether the column is a server-generated identity. */
	public final IsAutoIncrement:Bool;

	/** Which identity form the column takes; meaningless where `IsAutoIncrement` is false. */
	public final Identity:IdentityKind;

	/** Whether a Guid key is generated by the database. */
	public final ServerGeneratedGuid:Bool;

	/** The collation, or null for the default. */
	public final Collation:Null<String>;

	/** A note on what the column references, where its key was lifted out of the CREATE TABLE. */
	public var ReferencesNote:Null<String>;

	public function new(name:String, type:SqlType, isNullable:Bool = true, ?options:ColumnOptions) {
		this.Name = name;
		this.Type = type;
		this.IsNullable = isNullable;
		final o:ColumnOptions = options == null ? {} : options;
		this.DefaultValue = o.defaultValue;
		this.MaxLength = o.maxLength;
		this.Precision = o.precision;
		this.Scale = o.scale;
		this.GeneratedExpression = o.generatedExpression;
		this.GeneratedStored = o.generatedStored;
		this.IsAutoIncrement = o.isAutoIncrement == true;
		this.ServerGeneratedGuid = o.serverGeneratedGuid == true;
		this.GeneratedExpressionTree = o.generatedExpressionTree;
		this.Collation = o.collation;
		this.Identity = o.identity == null ? ByDefault : o.identity;
	}
}
