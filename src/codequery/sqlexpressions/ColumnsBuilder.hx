package codequery.sqlexpressions;

#if macro
import haxe.macro.Context;
import haxe.macro.Expr;
import haxe.macro.Type;

using haxe.macro.TypeTools;
#end

/**
	Generates one columns type per entity — the object a lambda's parameter is when the query runs:

	```haxe
	class BookingColumns extends RowColumns {
		public final id:ColumnSqlExpression;          // ColumnSqlExpression(source, "id", SqlInt)
		public final price:CurrentObjectColumns;      // the columns of an object flattened into this row
		public static var Shape(get, never):RowShape; // how a query hands these out and reads rows back
		public static function Read(row:Map<String, Dynamic>, prefix = ""):Booking;
	}
	```

	A clause written as a lambda over `Booking` compiles to a callback over `BookingColumns`, so what
	`b.price.zar` reaches inside it is the column — built on the source the lambda parameter stands
	for, by position, which the statement settles when it renders. `Read` is the other direction:
	a fetched row back into the entity, each column by the type its field declares.

	The type is defined while compiling, the first time an entity is queried.
**/
class ColumnsBuilder {
	#if macro
	/** One definition per class, however many lambdas ask for it. */
	static final defined = new Map<String, TypePath>();

	/** The columns type for `entity`, defining it if this is the first time it has been asked for. */
	public static function Of(entity:Type):TypePath {
		final row = switch entity.follow() {
			case TInst(t, _): t.get();
			case t: Context.error('${t.toString()} is not an entity class', Context.currentPos());
		}

		// Two modules may each declare a `Row`; the module is part of the name so they stay apart.
		final module = row.module.split(".").pop();
		final within = module == row.name ? "" : module + "_";
		final key = row.module + "." + row.name;
		final known = defined.get(key);
		if (known != null) {
			return known;
		}

		// A type private to its module carries the module as a `_Module` step of its package; the
		// generated type is public, so it lives in the package proper.
		final pack = row.pack.filter(step -> step != "_" + module);
		final path:TypePath = {pack: pack, name: within + row.name + "Columns"};
		defined.set(key, path);

		// A second compilation pass over the same source reaches this with the type already defined.
		if (Exists(path)) {
			return path;
		}

		Context.defineType({
			pack: path.pack,
			name: path.name,
			pos: row.pos,
			kind: TDClass({pack: ["codequery", "sqlexpressions"], name: "RowColumns"}, [], false, true, false),
			meta: [{name: ":keep", pos: row.pos}],
			doc: 'The columns of ${row.name}, as a lambda over it reaches them. Generated by ColumnsBuilder.',
			fields: Fields(row, entity, path)
		});

		return path;
	}

	/** The columns type as a type, for a callback's parameter. */
	public static function TypeOf(entity:Type):ComplexType {
		return TPath(Of(entity));
	}

	/** The `RowShape` of an entity — its columns type's, built once. */
	public static function ShapeOf(entity:Type):Expr {
		final path = Of(entity);
		return macro $p{path.pack.concat([path.name, "Shape"])};
	}

	static function Exists(path:TypePath):Bool {
		try {
			Context.getType(path.pack.concat([path.name]).join("."));
			return true;
		} catch (_:Dynamic) {
			return false;
		}
	}

	static function Fields(row:ClassType, entity:Type, path:TypePath):Array<Field> {
		final pack = path.pack;
		final fields:Array<Field> = [];
		final construct:Array<Expr> = [macro super(source, prefix)];
		final members:Array<Expr> = [];
		final reads:Array<Expr> = [];
		final pos = row.pos;

		for (field in row.fields.get()) {
			if (!IsColumn(field)) {
				continue;
			}
			final name = field.name;
			final column = ColumnNameOf(field);
			final nested = ObjectColumn(field.type);

			if (nested == null) {
				final columnType = SqlTypeOfField(field);
				fields.push({
					name: name,
					access: [APublic, AFinal],
					pos: field.pos,
					doc: 'The $column column.',
					kind: FVar(macro :codequery.sqlexpressions.ColumnSqlExpression)
				});
				construct.push(macro this.$name = new codequery.sqlexpressions.ColumnSqlExpression(source, prefix + $v{column}, $columnType));
				reads.push(Assign(field, Converted(field.type, macro row.get(prefix + $v{column}))));
			} else {
				// An object flattened into this row: its columns type, under this member's prefix.
				final inner = Of(field.type);
				final innerType = TPath(inner);
				final innerPath = inner.pack.concat([inner.name]);
				final prefixed = column + Separator;
				fields.push({
					name: name,
					access: [APublic, AFinal],
					pos: field.pos,
					doc: 'The columns of $name, flattened into this row as $prefixed….',
					kind: FVar(innerType)
				});
				construct.push(macro this.$name = new $inner(source, prefix + $v{prefixed}));
				reads.push(Assign(field, macro $p{innerPath.concat(["Read"])}(row, prefix + $v{prefixed})));
			}
			members.push(macro {name: $v{name}, column: $v{column}, value: this.$name});
		}

		fields.push({
			name: "new",
			access: [APublic],
			pos: pos,
			kind: FFun({
				args: [
					{name: "source", type: macro :codequery.sqlexpressions.ISqlSource},
					{name: "prefix", type: macro :String, value: macro ""}
				],
				ret: null,
				expr: {expr: EBlock(construct), pos: pos}
			})
		});

		fields.push({
			name: "Members",
			access: [APublic, AOverride],
			pos: pos,
			kind: FFun({
				args: [],
				ret: macro :Array<codequery.sqlexpressions.RowColumns.RowMember>,
				expr: macro return ${{expr: EArrayDecl(members), pos: pos}}
			})
		});

		// The entity read back from a fetched row: an instance made without its constructor, since a
		// constructor may want arguments a row does not have, and every column put in by its type.
		// A type private to its module cannot be named from here, so it is reached by its runtime
		// name instead and the row read back untyped.
		final modulePath = row.module.split(".");
		final moduleName = modulePath[modulePath.length - 1];
		final entityPath = moduleName == row.name ? modulePath : modulePath.concat([row.name]);
		final entityType = row.isPrivate ? (macro :Dynamic) : entity.toComplexType();
		final privateName = pack.concat(["_" + moduleName, row.name]).join(".");
		final made = row.isPrivate
			? macro {
				final resolved = Type.resolveClass($v{privateName});
				resolved == null ? {} : Type.createEmptyInstance(resolved);
			}
			: macro Type.createEmptyInstance($p{entityPath});
		fields.push({
			name: "Read",
			access: [APublic, AStatic],
			pos: pos,
			doc: 'A fetched row as a ${row.name}, its columns read under `prefix`.',
			kind: FFun({
				args: [
					{name: "row", type: macro :Map<String, Dynamic>},
					{name: "prefix", type: macro :String, value: macro ""}
				],
				ret: entityType,
				expr: macro {
					final entity:$entityType = $made;
					$b{reads};
					return entity;
				}
			})
		});

		final columnsPath = path.pack.concat([path.name]);
		LazyStatic(fields, "Shape", macro :codequery.RowShape,
			macro new codequery.RowShape(index -> new $path(codequery.sqlexpressions.ParameterSqlSource.At(index)),
				row -> $p{columnsPath.concat(["Read"])}(row)),
			pos, 'How a query hands out these columns, and reads a row back as a ${row.name}.');

		return fields;
	}

	/** `entity.field = value` — through reflection where the field is final and cannot be assigned. */
	static function Assign(field:ClassField, value:Expr):Expr {
		final name = field.name;
		return switch field.kind {
			case FVar(_, AccCtor | AccNever | AccNo): macro Reflect.setField(entity, $v{name}, $value);
			case _: macro entity.$name = cast $value;
		}
	}

	/** The value as the field's type wants it: a reader for what a column can hold, the value itself otherwise. */
	static function Converted(type:Type, value:Expr):Expr {
		final reader = ReaderOf(type);
		return reader == null ? value : macro $p{["codequery", "RowReader", reader]}($value);
	}

	/** The `RowReader` method that reads a value of `type`, or null where it is read as it came. */
	public static function ReaderOf(type:Type):Null<String> {
		return switch type.followWithAbstracts() {
			case TAbstract(_.get() => {name: "Int"}, _): "AsInt";
			case TAbstract(_.get() => {name: "Float"}, _): "AsFloat";
			case TAbstract(_.get() => {name: "Bool"}, _): "AsBool";
			case TInst(_.get() => {name: "String"}, _): "AsString";
			case TInst(_.get() => {name: "Date"}, _): "AsDate";
			case _: null;
		}
	}

	/**
		What a column holds, read from the field's type — and from `@columnMaxLength`, which is what
		separates a bounded string from an unbounded one.
	**/
	public static function SqlTypeOfField(field:ClassField):Expr {
		final bounded = switch field.meta.extract("columnMaxLength") {
			case [{params: [{expr: EConst(CInt(v, _))}]}]: Std.parseInt(v);
			case _: null;
		}

		// How exact a decimal is — `@columnPrecision(12, 4)`, C#'s `[DbColumnPrecision(12, 4)]`, also
		// spelled `@dbColumnPrecision`; the scale defaults to none, which is what `DECIMAL(p)` means.
		final stated = field.meta.extract("columnPrecision").concat(field.meta.extract("dbColumnPrecision"));
		final precision = switch stated {
			case [{params: [{expr: EConst(CInt(p, _))}]}]: {p: Std.parseInt(p), s: 0};
			case [{params: [{expr: EConst(CInt(p, _))}, {expr: EConst(CInt(s, _))}]}]:
				{p: Std.parseInt(p), s: Std.parseInt(s)};
			case _: null;
		}

		// Unwrapped first, so an enum abstract is its underlying number and SqlDate is a date.
		final name = switch field.type.followWithAbstracts() {
			case TAbstract(_.get() => {name: "Int"}, _): "SqlInt";
			case TAbstract(_.get() => {name: "Float"}, _): precision == null ? "SqlFloat" : "SqlDecimal";
			case TAbstract(_.get() => {name: "Bool"}, _): "SqlBool";
			case TInst(_.get() => {name: "Date"}, _): "SqlTimestamp";
			case TInst(_.get() => {name: "String"}, _): bounded == null ? "SqlText" : "SqlVarChar";
			case _: "SqlUnknown";
		}

		if (name == "SqlDecimal") {
			return macro codequery.sqlexpressions.SqlType.SqlDecimal($v{precision.p}, $v{precision.s});
		}
		return name == "SqlVarChar"
			? macro codequery.sqlexpressions.SqlType.SqlVarChar($v{bounded})
			: macro $p{["codequery", "sqlexpressions", "SqlType", name]};
	}

	/** The `SqlType` a value of a Haxe type is, without a field's metadata to refine it. */
	public static function SqlTypeOfType(type:Type):Expr {
		final name = switch type.followWithAbstracts() {
			case TAbstract(_.get() => {name: "Int"}, _): "SqlInt";
			case TAbstract(_.get() => {name: "Float"}, _): "SqlFloat";
			case TAbstract(_.get() => {name: "Bool"}, _): "SqlBool";
			case TInst(_.get() => {name: "Date"}, _): "SqlTimestamp";
			case TInst(_.get() => {name: "String"}, _): "SqlText";
			case _: "SqlUnknown";
		}
		return macro $p{["codequery", "sqlexpressions", "SqlType", name]};
	}

	/** What joins the parts of a flattened member's name, as `ProjectionMember.Separator` does in C#. */
	public static final Separator = "_";

	/**
		The class behind a member that is an object rather than a value, or null for a value.

		Everything a column can hold on its own is a value: the numbers and strings, a date, and an
		enum abstract, which is its underlying value by the time SQL sees it.
	**/
	public static function ObjectColumn(type:Type):Null<ClassType> {
		return switch type.follow() {
			case TInst(t, _):
				final row = t.get();
				final name = row.pack.concat([row.name]).join(".");
				(name == "String" || name == "Date") ? null : row;
			case _:
				null;
		}
	}

	/**
		Adds a static built the first time it is asked for.

		Haxe runs static initialisers in the order it generated the types, and a type that uses
		these columns can be generated before them — a `static final db = new SampleDb()` in the
		entry point is enough — which would read them as null. Building on first use puts the order
		beyond doubt.
	**/
	static function LazyStatic(into:Array<Field>, name:String, type:ComplexType, build:Expr, pos:Position, doc:String):Void {
		final held = macro $i{"_" + name};

		into.push({
			name: "_" + name,
			access: [AStatic],
			pos: pos,
			kind: FVar(type, null)
		});
		into.push({
			name: name,
			access: [APublic, AStatic],
			pos: pos,
			doc: doc,
			kind: FProp("get", "never", type)
		});
		into.push({
			name: "get_" + name,
			access: [AStatic],
			pos: pos,
			kind: FFun({
				args: [],
				ret: type,
				expr: macro {
					if ($held == null) {
						$held = $build;
					}
					return $held;
				}
			})
		});
	}

	/** A public instance variable is a column; methods and properties with accessors are not. */
	public static function IsColumn(field:ClassField):Bool {
		return field.isPublic && switch field.kind {
			case FVar(AccNormal | AccNo, _): true;
			case _: false;
		}
	}

	/** The table an entity type maps to. */
	public static function TableNameOfType(entity:Type):String {
		return switch entity.follow() {
			case TInst(t, _): TableNameOf(t.get());
			case t: Context.error('${t.toString()} is not an entity class', Context.currentPos());
		}
	}

	/** The entity's `@tableName`, else the type's own name — the rule the C# inspector applies. */
	public static function TableNameOf(row:ClassType):String {
		return switch row.meta.extract("tableName") {
			case [{params: [{expr: EConst(CString(name, _))}]}]: name;
			case _: row.name;
		}
	}

	/** A field's `@columnName`, else the field's own name. */
	public static function ColumnNameOf(field:ClassField):String {
		return switch field.meta.extract("columnName") {
			case [{params: [{expr: EConst(CString(name, _))}]}]: name;
			case _: field.name;
		}
	}
	#end
}
