package codequery.sqlexpressions;

#if macro
import haxe.macro.Context;
import haxe.macro.Expr;
import haxe.macro.Type;

using haxe.macro.TypeTools;
#end

/**
	Generates one type of static columns per entity, so a predicate compiles to a reference rather
	than to a column built afresh on every call:

	```haxe
	class DeliveryColumns {
		public static var id(get, never):ColumnSqlExpression; // ColumnSqlExpression(parameter 0, "id")
	}
	```

	The type is defined while compiling and is what `a.id` inside a lambda resolves to.

	A column names the source it belongs to by the *position* of the lambda parameter it was reached
	through, so there is a type per position: `DeliveryColumns` for the first parameter,
	`DeliveryColumns1` for the second, and so on. Only the positions a program actually uses are
	generated. What each position resolves to is the statement's business, settled when it renders —
	which is what lets the same table be joined to itself.
**/
class ColumnsBuilder {
	#if macro
	/** One definition per entity, however many predicates ask for it. */
	static final defined = new Map<String, TypePath>();

	/**
		The columns type for `entity` as seen through the lambda parameter at `index`, defining it if
		this is the first time that pairing has been asked for.
	**/
	public static function Of(entity:Type, index:Int):TypePath {
		final row = switch entity.follow() {
			case TInst(t, _): t.get();
			case t: Context.error('${t.toString()} is not an entity class', Context.currentPos());
		}

		final key = row.pack.concat([row.name]).join(".") + "#" + index;
		final known = defined.get(key);
		if (known != null) {
			return known;
		}

		final path:TypePath = {pack: row.pack, name: row.name + "Columns" + (index == 0 ? "" : Std.string(index))};
		defined.set(key, path);

		// A second compilation pass over the same source reaches this with the type already defined.
		if (Exists(path)) {
			return path;
		}

		Context.defineType({
			pack: path.pack,
			name: path.name,
			pos: row.pos,
			kind: TDClass(null, [], false, true, false),
			meta: [{name: ":keep", pos: row.pos}],
			doc: 'The columns of ${row.name} as the lambda parameter at position $index sees them. Generated by ColumnsBuilder.',
			fields: Fields(row, path, index)
		});

		return path;
	}

	/** An expression naming a member of a columns type, e.g. `model.DeliveryColumns.id`. */
	public static function Member(path:TypePath, name:String):Expr {
		return macro $p{path.pack.concat([path.name, name])};
	}

	static function Exists(path:TypePath):Bool {
		try {
			Context.getType(path.pack.concat([path.name]).join("."));
			return true;
		} catch (_:Dynamic) {
			return false;
		}
	}

	static function Fields(row:ClassType, path:TypePath, index:Int):Array<Field> {
		final fields:Array<Field> = [];

		LazyStatic(fields, "Source", macro :codequery.sqlexpressions.ParameterSqlSource,
			macro codequery.sqlexpressions.ParameterSqlSource.At($v{index}),
			row.pos, 'The source the lambda parameter at position $index stands for.');

		final source = Member(path, "Source");
		for (field in row.fields.get()) {
			if (!IsColumn(field)) {
				continue;
			}
			final column = ColumnNameOf(field);
			LazyStatic(fields, field.name, macro :codequery.sqlexpressions.ColumnSqlExpression,
				macro new codequery.sqlexpressions.ColumnSqlExpression($source, $v{column}),
				field.pos, 'The $column column.');
		}

		return fields;
	}

	/**
		Adds a static built the first time it is asked for.

		Haxe runs static initialisers in the order it generated the types, and a type that uses
		these columns can be generated before them — a `static final db = new SampleDb()` in the
		entry point is enough — which would read them as null. Building on first use puts the order
		beyond doubt.
	**/
	static function LazyStatic(into:Array<Field>, name:String, type:ComplexType, build:Expr, pos:Position, doc:String):Void {
		final held = macro $i{"_" + name};

		into.push({
			name: "_" + name,
			access: [AStatic],
			pos: pos,
			kind: FVar(type, null)
		});
		into.push({
			name: name,
			access: [APublic, AStatic],
			pos: pos,
			doc: doc,
			kind: FProp("get", "never", type)
		});
		into.push({
			name: "get_" + name,
			access: [AStatic],
			pos: pos,
			kind: FFun({
				args: [],
				ret: type,
				expr: macro {
					if ($held == null) {
						$held = $build;
					}
					return $held;
				}
			})
		});
	}

	/** A public instance variable is a column; methods and properties with accessors are not. */
	static function IsColumn(field:ClassField):Bool {
		return field.isPublic && switch field.kind {
			case FVar(AccNormal | AccNo, _): true;
			case _: false;
		}
	}

	/** The table an entity type maps to. */
	public static function TableNameOfType(entity:Type):String {
		return switch entity.follow() {
			case TInst(t, _): TableNameOf(t.get());
			case t: Context.error('${t.toString()} is not an entity class', Context.currentPos());
		}
	}

	/** The entity's `@tableName`, else the type's own name — the rule the C# inspector applies. */
	public static function TableNameOf(row:ClassType):String {
		return switch row.meta.extract("tableName") {
			case [{params: [{expr: EConst(CString(name, _))}]}]: name;
			case _: row.name;
		}
	}

	/** A field's `@columnName`, else the field's own name. */
	public static function ColumnNameOf(field:ClassField):String {
		return switch field.meta.extract("columnName") {
			case [{params: [{expr: EConst(CString(name, _))}]}]: name;
			case _: field.name;
		}
	}
	#end
}
