package codequery.sqlexpressions;

#if macro
import haxe.macro.Context;
import haxe.macro.Expr;
import haxe.macro.Type;

using haxe.macro.TypeTools;
#end

/**
	Generates one type of static columns per entity, so a predicate compiles to a reference rather
	than to a column built afresh on every call:

	```haxe
	class DeliveryColumns {
		public static final Source = new TableSqlSource(new QualifiedTableName("delivery"), "delivery");
		public static final id = new ColumnSqlExpression(Source, "id");
	}
	```

	The type is defined while compiling, once per entity, and is what `a.id` inside a predicate
	resolves to.

	A column is therefore tied to its table rather than to a statement, which is the one thing this
	gives up: a source no longer carries a per-statement alias. Until a statement can name the same
	table twice — a self-join, or a correlated subquery — nothing needs one.
**/
class ColumnsBuilder {
	#if macro
	/** One definition per entity, however many predicates ask for it. */
	static final defined = new Map<String, TypePath>();

	/** The columns type for `entity`, defining it if this is the first time it has been asked for. */
	public static function Of(entity:Type):TypePath {
		final row = switch entity.follow() {
			case TInst(t, _): t.get();
			case t: Context.error('${t.toString()} is not an entity class', Context.currentPos());
		}

		final key = row.pack.concat([row.name]).join(".");
		final known = defined.get(key);
		if (known != null) {
			return known;
		}

		final path:TypePath = {pack: row.pack, name: row.name + "Columns"};
		defined.set(key, path);

		// A second compilation pass over the same source reaches this with the type already defined.
		if (Exists(path)) {
			return path;
		}

		Context.defineType({
			pack: path.pack,
			name: path.name,
			pos: row.pos,
			kind: TDClass(null, [], false, true, false),
			meta: [{name: ":keep", pos: row.pos}],
			doc: 'The columns of ${row.name}, as SQL expressions. Generated by ColumnsBuilder.',
			fields: Fields(row, path)
		});

		return path;
	}

	/** An expression naming a member of a columns type, e.g. `model.DeliveryColumns.id`. */
	public static function Member(path:TypePath, name:String):Expr {
		return macro $p{path.pack.concat([path.name, name])};
	}

	static function Exists(path:TypePath):Bool {
		try {
			Context.getType(path.pack.concat([path.name]).join("."));
			return true;
		} catch (_:Dynamic) {
			return false;
		}
	}

	static function Fields(row:ClassType, path:TypePath):Array<Field> {
		final table = TableNameOf(row);
		final source = Member(path, "Source");

		final fields:Array<Field> = [
			{
				name: "Source",
				access: [APublic, AStatic, AFinal],
				pos: row.pos,
				doc: "The table these columns belong to.",
				kind: FVar(macro :codequery.sqlexpressions.TableSqlSource,
					macro new codequery.sqlexpressions.TableSqlSource(new codequery.QualifiedTableName($v{table}), $v{table}))
			}
		];

		for (field in row.fields.get()) {
			if (!IsColumn(field)) {
				continue;
			}
			fields.push({
				name: field.name,
				access: [APublic, AStatic, AFinal],
				pos: field.pos,
				doc: 'The ${ColumnNameOf(field)} column.',
				kind: FVar(macro :codequery.sqlexpressions.ColumnSqlExpression,
					macro new codequery.sqlexpressions.ColumnSqlExpression($source, $v{ColumnNameOf(field)}))
			});
		}

		return fields;
	}

	/** A public instance variable is a column; methods and properties with accessors are not. */
	static function IsColumn(field:ClassField):Bool {
		return field.isPublic && switch field.kind {
			case FVar(AccNormal | AccNo, _): true;
			case _: false;
		}
	}

	/** The entity's `@tableName`, else the type's own name — the rule the C# inspector applies. */
	public static function TableNameOf(row:ClassType):String {
		return switch row.meta.extract("tableName") {
			case [{params: [{expr: EConst(CString(name, _))}]}]: name;
			case _: row.name;
		}
	}

	/** A field's `@columnName`, else the field's own name. */
	public static function ColumnNameOf(field:ClassField):String {
		return switch field.meta.extract("columnName") {
			case [{params: [{expr: EConst(CString(name, _))}]}]: name;
			case _: field.name;
		}
	}
	#end
}
