package codequery.migrations;

import codequery.migrations.DatabaseColumnType;
import codequery.sqldrivers.AnsiSqlRenderer;
import codequery.sqlexpressions.ColumnDefinition;
import codequery.sqlexpressions.ConstSqlExpression;
import codequery.sqlexpressions.ISqlExpression;
import codequery.sqlexpressions.RawSqlExpression;
import codequery.sqlexpressions.SqlType;

/** What a column definition may say beyond its name, type and nullability — C#'s object initializer. */
typedef DatabaseColumnOptions = {
	?isAutoIncrement:Bool,
	?identity:IdentityKind,
	?serverGeneratedGuid:Bool,
	?defaultValue:String,
	?maxLength:Int,
	?precision:Int,
	?scale:Int,
	?collation:String,
	?comment:String,
	?generatedExpression:String,
	?generatedStored:Bool,
	?ordinalIndex:Int
}

/**
	A column, as the schema describes it: the C# `DatabaseColumnDefinition`.

	Built either from a SQL type, which is what the entities say, or from a column type with the
	length or precision beside it, which is what a snapshot says. Haxe has no overloading, so the
	constructor takes either: `new DatabaseColumnDefinition("id", SqlInt, false)` or
	`new DatabaseColumnDefinition("Id", DatabaseColumnType.Int, true, {maxLength: 50})`.
**/
class DatabaseColumnDefinition {
	public var Name:String;
	public var Type:DatabaseColumnType;
	public var Nullable:Bool;

	/** Whether the database generates it, which is what a key usually is. */
	public var PrimaryKey:Bool;

	public var IsAutoIncrement:Bool = false;
	public var Identity:IdentityKind = ByDefault;

	/** Whether a Guid key is generated by the database. */
	public var ServerGeneratedGuid:Bool = false;

	/** The column's DEFAULT in a stable, provider-neutral string form; what the snapshot stores. */
	public var DefaultValue:Null<String> = null;

	/** The default as an expression tree, present when the column came from code. */
	public var DefaultValueTree:Null<ISqlExpression> = null;

	/** The value the default was read from, when it came from the entity's own initializer. */
	public var DeclaredDefault:Null<Dynamic> = null;

	public var MaxLength:Null<Int> = null;
	public var Precision:Null<Int> = null;
	public var Scale:Null<Int> = null;
	public var Collation:Null<String> = null;
	public var Comment:Null<String> = null;

	/** The generated column's expression in its stable string form (null for a normal column). */
	public var GeneratedExpression:Null<String> = null;

	/** The generated expression as a tree, in memory only. */
	public var GeneratedExpressionTree:Null<ISqlExpression> = null;

	/** Whether a generated column is stored rather than computed on read. */
	public var GeneratedStored:Null<Bool> = null;

	/**
		The column's place among the others, captured when the table was read. Excluded from
		`Matches` so a pure reorder is not a change; what tells a rename from a drop and an add.
	**/
	public var OrdinalIndex:Null<Int> = null;

	public function new(name:String = "", ?type:SqlType, ?columnType:DatabaseColumnType, nullable:Bool = true,
			?primaryKey:Bool, ?options:DatabaseColumnOptions) {
		this.Name = name;
		this.Nullable = nullable;
		this.PrimaryKey = primaryKey == true;

		if (type != null) {
			// A precision no database would take is refused here, naming the column, rather than by
			// the database naming nothing.
			switch type {
				case SqlDecimal(precision, scale) if (precision <= 0):
					throw 'Column $name: a decimal has at least one digit, not $precision';
				case SqlDecimal(precision, scale) if (scale > precision):
					throw 'Column $name: a decimal cannot keep more after the point ($scale) than it has digits ($precision)';
				case _:
			}
			final recorded = DatabaseColumnTypes.OfSqlType(type);
			this.Type = recorded.type;
			this.MaxLength = recorded.maxLength;
			this.Precision = recorded.precision;
			this.Scale = recorded.scale;
		} else {
			this.Type = columnType == null ? Unknown : columnType;
		}

		if (options != null) {
			if (options.isAutoIncrement != null) IsAutoIncrement = options.isAutoIncrement;
			if (options.identity != null) Identity = options.identity;
			if (options.serverGeneratedGuid != null) ServerGeneratedGuid = options.serverGeneratedGuid;
			DefaultValue = options.defaultValue;
			MaxLength = options.maxLength;
			Precision = options.precision;
			Scale = options.scale;
			Collation = options.collation;
			Comment = options.comment;
			GeneratedExpression = options.generatedExpression;
			GeneratedStored = options.generatedStored;
			OrdinalIndex = options.ordinalIndex;
		}
	}

	/** The C# object-initializer form: a column by its recorded type. */
	public static function Of(name:String, type:DatabaseColumnType, nullable:Bool = true):DatabaseColumnDefinition {
		return new DatabaseColumnDefinition(name, type, nullable);
	}

	public var IsNullable(get, set):Bool;

	function get_IsNullable():Bool {
		return Nullable;
	}

	function set_IsNullable(value:Bool):Bool {
		return Nullable = value;
	}

	/** The SQL type a statement over this column carries. */
	public function SqlType():SqlType {
		return DatabaseColumnTypes.ToSqlType(Type, MaxLength, Precision, Scale);
	}

	/** Sets the default from its tree, deriving the stored provider-neutral string form. */
	public function SetDefaultValue(tree:ISqlExpression):Void {
		DefaultValueTree = tree;
		DefaultValue = new AnsiSqlRenderer().Render(tree);
	}

	/** Sets the generated expression from its tree, deriving the stored provider-neutral string form. */
	public function SetGeneratedExpression(tree:ISqlExpression):Void {
		GeneratedExpressionTree = tree;
		GeneratedExpression = new AnsiSqlRenderer().Render(tree);
	}

	/**
		The column's default as a plain value, where it has one that can be known here — a constant.
		Null for a default the database evaluates, which nothing here can say the value of.
	**/
	public function TryDefaultValue():Null<Dynamic> {
		if (DeclaredDefault != null) {
			return DeclaredDefault;
		}
		final constant = Std.downcast(cast DefaultValueTree, ConstSqlExpression);
		if (constant == null) {
			return null;
		}
		return switch constant.Value {
			case SqlConstBool(v): v;
			case SqlConstInt(v): v;
			case SqlConstFloat(v): v;
			case SqlConstString(v): v;
			case SqlConstDate(v): v;
			case SqlConstNull: null;
		}
	}

	/** The column as a CREATE TABLE states it. */
	public function ToColumnDefinition():ColumnDefinition {
		// The tree where there is one; a snapshot-loaded column has only the string, which is SQL
		// already and goes through as it stands.
		final defaultExpression:Null<ISqlExpression> = DefaultValueTree != null
			? DefaultValueTree
			: (DefaultValue != null ? new RawSqlExpression(DefaultValue) : null);

		final made = new ColumnDefinition(Name, SqlType(), Nullable, defaultExpression, MaxLength, Precision, Scale,
			IsAutoIncrement, Collation, Identity);
		made.GeneratedExpression = GeneratedExpression;
		made.GeneratedExpressionTree = GeneratedExpressionTree;
		made.GeneratedStored = GeneratedStored;
		made.ServerGeneratedGuid = ServerGeneratedGuid;
		return made;
	}

	/** A copy, so a canonical ordering never disturbs the live schema. */
	public function Clone():DatabaseColumnDefinition {
		final copy = new DatabaseColumnDefinition(Name, Type, Nullable, PrimaryKey);
		copy.IsAutoIncrement = IsAutoIncrement;
		copy.Identity = Identity;
		copy.ServerGeneratedGuid = ServerGeneratedGuid;
		copy.DefaultValue = DefaultValue;
		copy.DefaultValueTree = DefaultValueTree;
		copy.DeclaredDefault = DeclaredDefault;
		copy.MaxLength = MaxLength;
		copy.Precision = Precision;
		copy.Scale = Scale;
		copy.Collation = Collation;
		copy.Comment = Comment;
		copy.GeneratedExpression = GeneratedExpression;
		copy.GeneratedExpressionTree = GeneratedExpressionTree;
		copy.GeneratedStored = GeneratedStored;
		copy.OrdinalIndex = OrdinalIndex;
		return copy;
	}

	/** Whether two describe the same column, which is what a diff turns on. Position is not part of it. */
	public function Matches(other:DatabaseColumnDefinition):Bool {
		return Name == other.Name
			&& Std.string(Type) == Std.string(other.Type)
			&& Nullable == other.Nullable
			&& IsAutoIncrement == other.IsAutoIncrement
			&& Std.string(Identity) == Std.string(other.Identity)
			&& ServerGeneratedGuid == other.ServerGeneratedGuid
			&& DefaultValue == other.DefaultValue
			&& MaxLength == other.MaxLength
			&& Precision == other.Precision
			&& Scale == other.Scale
			&& Collation == other.Collation
			&& GeneratedExpression == other.GeneratedExpression
			&& GeneratedStored == other.GeneratedStored;
	}

	/** The C# `Equals`. */
	public function Equals(other:DatabaseColumnDefinition):Bool {
		return other != null && Matches(other);
	}
}
