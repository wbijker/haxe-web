package codequery;

/**
	Which form a server-generated integer key takes. The database's part is the same in all three —
	it hands out the next number — and what differs is what happens when a row arrives carrying a
	key of its own.
**/
enum IdentityKind {
	/** `GENERATED BY DEFAULT AS IDENTITY` — a row may carry its own key. The default. */
	ByDefault;

	/** `GENERATED ALWAYS AS IDENTITY` — an explicit key is refused unless the insert overrides. */
	Always;

	/** `SERIAL` / `BIGSERIAL` — an integer whose default draws from a sequence of its own. */
	Serial;
}
