# Build and run on the eval target (Haxe's built-in interpreter).
--class-path src
--main Main
--interp

--next

# Build the same source to PHP and run the generated app — against the sample's MySQL server
# (see README: docker, 127.0.0.1:3306, codequery_sample, docker/docker), through PDO.
# Haxe 4's PHP target emits PHP 7.0+ code; there is no PHP 5 target to opt out of.
--class-path src
--main Main
--php bin/php
--macro codequery.php.ChainLayout.apply()
--cmd php bin/php/index.php

--next

# The PHP runtime, end to end: an in-memory database, so it needs nothing set up.
--class-path src
--main RunPhp
--php bin/php-runtime
--macro codequery.php.ChainLayout.apply()
--cmd php bin/php-runtime/index.php

--next

# The schema, end to end: scaffolded, written, applied, used, undone.
--class-path src
--main RunMigrations
--php bin/php-migrations
--macro codequery.php.ChainLayout.apply()
--cmd php bin/php-migrations/index.php bin/migrations
